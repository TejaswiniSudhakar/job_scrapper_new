"""
Standalone test for the Indeed (anonymous) scraper.
No project dependencies - runs entirely on its own.
Saves results to indeed_test_results.csv so you can
verify title/company/description actually match.

Usage:
    python test_indeed.py

Adjust the TEST_* constants below before running.
"""

import csv
import random
import re
import subprocess
import time

import undetected_chromedriver as uc
from selenium.webdriver.common.by import By
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.support.ui import WebDriverWait

# -----------------------------------------------------------------------
# TEST CONFIG — edit these before running
# -----------------------------------------------------------------------
PROFILE_DIR  = r"C:\IndeedScraperProfile"   # separate dir from your main project
PROFILE_NAME = "Default"
KEYWORD      = "software engineer"
LOCATION     = "Bengaluru"
DAYS_OLD     = 3
RADIUS       = 25
MAX_JOBS     = 10   # stop after this many jobs so the test run is short
CSV_FILE     = "indeed_test_results.csv"
# -----------------------------------------------------------------------

CSV_FIELDNAMES = ["job_title", "company_name", "location", "salary", "job_url", "job_description"]


class IndeedVerificationError(Exception):
    pass


def random_pause(min_seconds=1.0, max_seconds=3.0):
    time.sleep(random.uniform(min_seconds, max_seconds))


def _get_chrome_major_version():
    for hive in (r"HKLM\SOFTWARE\Google\Chrome\BLBeacon",
                 r"HKCU\SOFTWARE\Google\Chrome\BLBeacon"):
        try:
            out = subprocess.check_output(
                f'reg query "{hive}" /v version',
                shell=True, stderr=subprocess.DEVNULL
            ).decode()
            match = re.search(r"(\d+)\.\d+\.\d+\.\d+", out)
            if match:
                return int(match.group(1))
        except Exception:
            pass
    return None


def create_driver():
    options = uc.ChromeOptions()
    options.add_argument("--start-maximized")
    options.add_argument(f"--user-data-dir={PROFILE_DIR}")
    options.add_argument(f"--profile-directory={PROFILE_NAME}")
    version = _get_chrome_major_version()
    driver = uc.Chrome(version_main=version, options=options)
    return driver


def is_verification_page(driver):
    try:
        page_source = driver.page_source.lower()
        return "additional verification required" in page_source
    except Exception:
        return False


def get_next_page_button(driver, timeout=10):
    def locate_visible_next_button(current_driver):
        buttons = current_driver.find_elements(By.XPATH, "//a[@aria-label='Next Page']")
        for button in buttons:
            try:
                if (
                    button.is_displayed()
                    and button.is_enabled()
                    and button.size["width"] > 0
                    and button.size["height"] > 0
                ):
                    return button
            except Exception:
                continue
        return False
    return WebDriverWait(driver, timeout).until(locate_visible_next_button)


def get_visible_job_links(driver):
    visible_jobs = []
    job_elements = driver.find_elements(By.XPATH, "//a[@data-jk]")
    for element in job_elements:
        try:
            job_id = element.get_attribute("data-jk")
            href   = element.get_attribute("href")
            title  = element.text.strip()
            if (
                job_id and href
                and element.is_displayed()
                and element.is_enabled()
                and element.size["width"] > 0
                and element.size["height"] > 0
            ):
                visible_jobs.append({"job_id": job_id, "href": href, "title": title})
        except Exception:
            continue

    unique_jobs = []
    seen_ids = set()
    for job in visible_jobs:
        if job["job_id"] not in seen_ids:
            seen_ids.add(job["job_id"])
            unique_jobs.append(job)
    return unique_jobs


def find_job_link_element(driver, job_info, timeout=10):
    job_id = job_info.get("job_id")
    def locate_job(current_driver):
        candidates = current_driver.find_elements(By.XPATH, f"//a[@data-jk='{job_id}']")
        for candidate in candidates:
            try:
                if (
                    candidate.is_displayed()
                    and candidate.is_enabled()
                    and candidate.size["width"] > 0
                    and candidate.size["height"] > 0
                ):
                    return candidate
            except Exception:
                continue
        return False
    return WebDriverWait(driver, timeout).until(locate_job)


def human_scroll(driver, target_element):
    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", target_element)
    random_pause(0.8, 1.8)
    target_y = target_element.location["y"]
    current_y = driver.execute_script("return window.pageYOffset;")
    while current_y < target_y:
        step = random.randint(150, 400)
        driver.execute_script(f"window.scrollBy(0, {step});")
        random_pause(0.4, 1.3)
        current_y += step
        if random.random() < 0.2:
            back = random.randint(50, 120)
            driver.execute_script(f"window.scrollBy(0, -{back});")
            random_pause(0.2, 0.6)
    driver.execute_script("window.scrollBy(0, 80);")
    random_pause(0.2, 0.5)


def human_move_and_click(driver, element):
    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", element)
    WebDriverWait(driver, 10).until(
        lambda d: element.is_displayed()
        and element.is_enabled()
        and element.size["width"] > 0
        and element.size["height"] > 0
    )
    random_pause(1.0, 2.5)
    driver.execute_script("arguments[0].click();", element)
    random_pause(1.5, 3.5)


# KEY FIX: use Selenium .text (not BeautifulSoup get_text) so that
# previous_description and current_text inside wait_for_job_content
# are extracted the exact same way - making the stale-panel comparison
# reliable.
def get_job_description(driver):
    elements = driver.find_elements(By.ID, "jobDescriptionText")
    if elements:
        return elements[0].text.strip()
    return ""


def wait_for_job_content(driver, previous_description="", timeout=25):
    """
    Waits until the job-detail panel shows content that is DIFFERENT
    from the previously-selected job's content.  Both sides of the
    comparison now use Selenium .text so they are formatted identically,
    making the != check actually reliable.
    """
    def content_loaded(current_driver):
        if is_verification_page(current_driver):
            return "verification"

        elements = current_driver.find_elements(By.ID, "jobDescriptionText")
        if not elements:
            return False

        current_text = elements[0].text.strip()

        # Must be non-empty AND actually different from the previous job's
        # content - a match here means the panel hasn't re-rendered yet.
        if current_text and current_text != previous_description:
            return "description"

        return False

    return WebDriverWait(driver, timeout).until(content_loaded)


def get_detail_location(driver):
    try:
        elem = WebDriverWait(driver, 5).until(
            EC.presence_of_element_located(
                (By.XPATH, "//div[@data-testid='inlineHeader-companyLocation']")
            )
        )
        return elem.text.strip()
    except Exception:
        return ""


def get_salary(driver):
    selectors = [
        (By.ID, "salaryInfoAndJobType"),
        (By.XPATH, "//div[@id='salaryInfoAndJobType']//span"),
        (By.XPATH, "//span[contains(text(), '₹')]"),
    ]
    for by, selector in selectors:
        try:
            text = driver.find_element(by, selector).text.strip()
            if text:
                return text
        except Exception:
            continue
    return ""


def get_company_name(driver):
    selectors = [
        (By.XPATH, "//div[@data-testid='inlineHeader-companyName']"),
        (By.CSS_SELECTOR, "[data-testid='company-name']"),
    ]
    for by, selector in selectors:
        try:
            text = driver.find_element(by, selector).text.strip()
            if text:
                return text
        except Exception:
            continue
    return "Unknown"


def save_to_csv(job):
    with open(CSV_FILE, "a", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=CSV_FIELDNAMES)
        writer.writerow(job)


def main():
    import os
    # Write CSV header if file doesn't exist yet
    if not os.path.exists(CSV_FILE):
        with open(CSV_FILE, "w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=CSV_FIELDNAMES)
            writer.writeheader()

    driver = create_driver()
    seen_urls = set()
    jobs_saved = 0

    try:
        url = (
            f"https://in.indeed.com/jobs?q={KEYWORD.replace(' ', '+')}"
            f"&l={LOCATION.replace(' ', '+')}"
            f"&fromage={DAYS_OLD}&radius={RADIUS}"
        )
        print(f"\nSearching: {url}\n")
        driver.get(url)
        random_pause(4.0, 7.0)

        page_number = 1

        while jobs_saved < MAX_JOBS:
            print(f"--- Page {page_number} ---")
            random_pause(2.0, 4.0)

            try:
                WebDriverWait(driver, 10).until(
                    EC.presence_of_all_elements_located((By.CSS_SELECTOR, "li.css-1ac2h1w"))
                )
            except Exception:
                print("Job list did not load. Stopping.")
                break

            for job_info in get_visible_job_links(driver):
                if jobs_saved >= MAX_JOBS:
                    break

                if job_info["href"] in seen_urls:
                    continue
                seen_urls.add(job_info["href"])

                try:
                    # Snapshot BEFORE clicking - same method as the comparison
                    # inside wait_for_job_content so the != check is reliable
                    previous_description = get_job_description(driver)

                    job_elem = find_job_link_element(driver, job_info)
                    human_scroll(driver, job_elem)
                    human_move_and_click(driver, job_elem)

                    load_state = wait_for_job_content(
                        driver,
                        previous_description=previous_description,
                        timeout=25,
                    )

                    if load_state == "verification":
                        print("  ⚠️  Verification page detected - stopping test run.")
                        return

                    random_pause(2.0, 4.0)

                    description  = get_job_description(driver)
                    company_name = get_company_name(driver)
                    location     = get_detail_location(driver) or LOCATION
                    salary       = get_salary(driver)

                    if not description:
                        print(f"  [SKIP] No description loaded for: {job_info['title']}")
                        continue

                    job_data = {
                        "job_title":       job_info["title"],
                        "company_name":    company_name,
                        "location":        location,
                        "salary":          salary,
                        "job_url":         job_info["href"],
                        "job_description": description,
                    }

                    save_to_csv(job_data)
                    jobs_saved += 1

                    print(f"  ✅ [{jobs_saved}/{MAX_JOBS}] {job_info['title']} @ {company_name} | {location}")
                    print(f"      URL: {job_info['href']}")
                    print(f"      Desc preview: {description[:120].replace(chr(10), ' ')}...")
                    print()

                except IndeedVerificationError:
                    print("  ⚠️  Verification error - stopping.")
                    return
                except Exception as e:
                    print(f"  ❌ Failed for {job_info.get('title', '?')}: {e}")

            if jobs_saved >= MAX_JOBS:
                break

            try:
                next_btn = get_next_page_button(driver, timeout=5)
                driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", next_btn)
                random_pause(1.5, 3.0)
                driver.execute_script("arguments[0].click();", next_btn)
                WebDriverWait(driver, 10).until(EC.staleness_of(next_btn))
                page_number += 1
                random_pause(5.0, 10.0)
            except Exception:
                print("No more pages.")
                break

        print(f"\nDone. {jobs_saved} jobs saved to {CSV_FILE}")
        print("Open the CSV and verify each row's title/company/description match the URL.")
        input("\nPress Enter to close the browser...")

    finally:
        driver.quit()


if __name__ == "__main__":
    main()